---
import Experience from "./Experience.astro";
import SectionContainer from "./SectionContainer.astro";
import Hero from "./Hero.astro";
import Briefcase from "../icons/Briefcase.astro";
import Code from "../icons/Code.astro";
import Projects from "./Projects.astro";
---

<main class="px-2">
  <SectionContainer id="hero" class="py-20 pb-20 md:py-35 md:pb-32">
    <Hero />
  </SectionContainer>

  <SectionContainer id="experiencia">
    <h2 class="text-white/90 text-3xl font-semibold mb-6 flex gap-x-2 items-center">
      <Briefcase class="size-8" />
      Experiencia
    </h2>
    <Experience />
  </SectionContainer>

  <SectionContainer id="proyectos">
    <h2 class="text-white/90 text-3xl font-semibold mb-6 flex gap-x-2 items-center">
      <Code class="size-8" />
      Proyectos
    </h2>
    <Projects />
  </SectionContainer>
</main>

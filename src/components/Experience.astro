---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
  {
    date: "Actualidad",
    title: "Desarrollador web (proyectos personales)",
    description:
      "Actualmente estoy desarrollando proyectos web personales para ganar experiencia práctica, mejorar mis habilidades y prepararme para oportunidades profesionales en el sector.",
  },
  {
    date: "Septiembre 2024 - Marzo 2025",
    title: "Formación como desarrollador web",
    description:
      "Me formé en desarrollo web fullstack, adquiriendo conocimientos sólidos en tecnologías como JavaScript, Node.js, React, SQL y Tailwind CSS.",
    link: "https://github.com/MohammedChlag",
  },
];
---

<ol class="relative border-s border-gray-200 ml-3">
  {
    EXPERIENCE.map((experience) => {
      return (
        <li class="mb-10 ms-4">
          <ExperienceItem {...experience} />
        </li>
      );
    })
  }
</ol>

---
import ReactIcon from "../icons/ReactIcon.astro";
import NodeIcon from "../icons/NodeIcon.astro";
import JavaScriptIcon from "../icons/JavaScriptIcon.astro";
import HtmlIcon from "../icons/HtmlIcon.astro";
import CssIcon from "../icons/CssIcon.astro";
import ExpressIcon from "../icons/ExpressIcon.astro";
import MysqlIcon from "../icons/MysqlIcon.astro";
import TailwindIcon from "../icons/TailwindIcon.astro";
import SocialPill from "./SocialPill.astro";
import GithubIcon from "../icons/GithubIcon.astro";

const TAGS = {
    REACT: {
        name: "React",
        class: "bg-blue-500 text-white",
        icon: ReactIcon,
    },
    NODE: {
        name: "Node.js",
        class: "bg-green-500 text-white",
        icon: NodeIcon,
    },
    JAVASCRIPT: {
        name: "JavaScript",
        class: "bg-sky-200/60 text-white",
        icon: JavaScriptIcon,
    },
    EXPRESS: {
        name: "Express",
        class: "bg-yellow-400/80 text-white",
        icon: ExpressIcon,
    },
    MYSQL: {
        name: "MySQL",
        class: "bg-blue-700 text-white",
        icon: MysqlIcon,
    },
    TAILWIND: {
        name: "Tailwind CSS",
        class: "bg-blue-400 text-white",
        icon: TailwindIcon,
    },
    HTML: {
        name: "HTML",
        class: "bg-orange-500 text-white",
        icon: HtmlIcon,
    },
    CSS: {
        name: "CSS",
        class: "bg-sky-400 text-white", // completa aqui con tailwind solo bg 
        icon: CssIcon,
    },
}
const PROJECTS = [  
  {
    title: "Travel Diary Api - Comparte tus viajes!",
    description:
    "Travel Diary Api, la aplicación que te permite registrar y compartir tus experiencias de viaje. Deja que el resto del mundo valore tu viaje.",
    github: "https://github.com/MohammedChlag/Proyecto-Travel-Diary-Front",
    image: "../../public/projects/TravelDiary.jpg",
    tags: [
      TAGS.REACT,
      TAGS.NODE,
      TAGS.EXPRESS,
      TAGS.MYSQL,
      TAGS.CSS
    ],
  },
  {
    title: "Hackloud - Disco duro online",
    description:
    "Aplicación web para almacenar archivos en la nube. Con sistema de autenticación, diseño responsive y funcionalidades de subida, descarga y compartición de archivos.",
    link: "https://hackloud.netlify.app/",
    github: "https://github.com/MohammedChlag/Proyecto-Disco-Duro-FRONT",
    image: "../../public/projects/Hackloud.jpg",
    tags: [
      TAGS.REACT,
      TAGS.NODE,
      TAGS.EXPRESS,
      TAGS.MYSQL,
      TAGS.TAILWIND,
    ],
  },
  {
    title: "Hackoji - Juego de memoria",
    description: "Juego de memoria con sistema de puntuación y diseño responsivo.",
    link: "https://hackoji.netlify.app/",
    github: "https://github.com/MohammedChlag/Proyecto-Parejas-Emojis",
    image: "../../public/projects/Hackoji.jpg",
    tags: [
      TAGS.HTML,
      TAGS.JAVASCRIPT,
      TAGS.CSS,
    ]
  }
];
---

{
  PROJECTS.map(({ title, description, image, tags, link = "#proyectos", github = "#" }) => (
    <article class="mb-16">
      <a href={link}
      target="_blank"
      >
        <h3 class="text-2xl font-semibold text-yellow-200 mt-4 mb-4">
          {title}
        </h3>
      </a>
      <p class="text-lg mb-4 text-white text-pretty">{description}</p>
      <SocialPill href={github}>
    <GithubIcon class="size-4 md:size-6" />
    GitHub
  </SocialPill>
     
      <img class="mt-2 rounded shadow-2xl shadow-white/10" src={image} alt=`Captura de pantalla del proyecto ${title}` />
      <ul class="flex flex-wrap gap-2 m-4">
  {tags.map((tag) => (
    <li>
      <span class={`${tag.class} flex  items-center gap-x-2 text-xs rounded-full px-2 py-1`}>
        <tag.icon class="size-4" />
        {tag.name}
      </span>
    </li>
  ))}
</ul>
    </article>
  ))
}
